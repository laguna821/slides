{
  "name": "achmage-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "npm run build:source && tsx scripts/build-web.ts",
    "preview": "tsx scripts/preview-web.ts",
    "check": "astro check && tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "content:check": "tsx scripts/prepare.ts --check",
    "content:import": "tsx scripts/import-html.ts",
    "brand:build": "tsx scripts/brand-assets.ts",
    "format": "prettier --write src scripts tests docs content *.json *.mjs README.md",
    "release:verify": "npm run build && npm run check && npm test && tsx scripts/release-gate.ts && tsx scripts/publication-approval.ts",
    "print:generate": "tsx scripts/generate-reader-pdfs.ts",
    "print:test": "tsx scripts/generate-reader-pdfs.ts --fixture",
    "print:english": "tsx scripts/build-english.ts --prepare && tsx scripts/generate-english-pdfs.ts",
    "upload:prepare": "tsx scripts/prepare-upload.ts",
    "upload:request": "tsx scripts/upload-request.ts",
    "approval:check": "tsx scripts/publication-approval.ts --required",
    "build:source": "tsx scripts/prepare.ts && astro build && tsx scripts/build-english.ts && tsx scripts/verify-build.ts && tsx scripts/verify-english.ts && tsx scripts/verify-web-contract.ts",
    "assets:sync": "tsx scripts/assets-sync.ts",
    "web:prepare": "tsx scripts/build-web.ts --write-redirects",
    "storage:check": "tsx scripts/verify-web-output.ts",
    "preview:prepared": "astro build && tsx scripts/build-english.ts && tsx scripts/verify-english.ts && tsx scripts/verify-web-contract.ts && tsx scripts/build-web.ts --write-redirects"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "26.6.4",
    "@types/sanitize-html": "2.16.2",
    "@types/turndown": "5.0.6",
    "esbuild": "0.28.1",
    "playwright": "1.62.1",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "astro": "7.3.7",
    "cheerio": "1.2.0",
    "marked": "18.1.0",
    "marked-footnote": "1.4.0",
    "sanitize-html": "2.18.0",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2",
    "zod": "4.6.5"
  }
}
