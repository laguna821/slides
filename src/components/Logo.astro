---
import wordmark from '../lib/brand-wordmark.json';
const { small = false } = Astro.props;
---

<a class:list={['brand', { small }]} href="/" aria-label="Achmage 홈">
  <svg viewBox={wordmark.viewBox} aria-hidden="true">
    <path d={wordmark.inkPath} fill="currentColor" fill-rule="evenodd" />
    <path d={wordmark.flowPath} fill="currentColor" fill-rule="evenodd" />
    <path d={wordmark.arcPath} fill="var(--brand-accent)" fill-rule="evenodd" />
  </svg>
</a>
