---
import { kindLabel, formatDate, media, formatDuration } from '../lib/content';
import WorkActions from './WorkActions.astro';
import type { PublicWork } from '../lib/schema';
interface Props {
  work: PublicWork;
  index?: number;
  large?: boolean;
}
const { work: w, large = false } = Astro.props;
const film = media.find((m) => m.workId === w.id);
const duration = film?.versions.find(
  (v) => v.id === film.currentVersion,
)?.duration;
---

<article class:list={['work-card', { large }]} data-work-id={w.id}>
  <a class="work-image" href={w.href} aria-label={w.title + ' 상세 보기'}>
    <img
      src={w.poster}
      alt={w.posterAlt}
      width="1440"
      height="810"
      loading={large ? 'eager' : 'lazy'}
    />
    {duration && <span class="duration-badge">{formatDuration(duration)}</span>}
  </a>
  <div class="work-info">
    <div class="work-meta">
      <span>
        {kindLabel[w.kind]}
        {w.status === 'study' ? ' · 습작' : ''}
      </span>
      <span>
        {w.dateKind === 'registered' ? '등록 ' : ''}
        {formatDate(w.date)}
      </span>
    </div>
    <h3>
      <a href={w.href}>{w.title}</a>
    </h3>
    {w.audience && <p class="card-context">{w.audience}</p>}
    <p class="card-summary">{w.summary}</p>
    {large && w.featuredReason && (
      <p class="selection-reason">{w.featuredReason}</p>
    )}
    <WorkActions work={w} />
    <p class="search-match" hidden></p>
  </div>
</article>
