---
import Base from '../layouts/Base.astro';
---

<Base title="페이지를 찾을 수 없습니다" noindex>
  <section class="page-intro page-gutter" data-slide-exempt>
    <span class="eyebrow">404</span>
    <h1>
      다른 장면으로
      <br />
      이동해 볼까요.
    </h1>
    <p class="intro-text">주소가 바뀌었거나 아직 공개되지 않은 자료입니다.</p>
    <div class="actions">
      <a class="button" href="/archive/">
        자료 찾아보기
      </a>
      <a class="button secondary" href="/">
        홈으로
      </a>
    </div>
  </section>
</Base>
