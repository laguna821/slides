---
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import { listed, kindLabel } from '../lib/content';
const topics = [...new Set(listed.flatMap((w) => w.topics))].sort((a, b) =>
  a.localeCompare(b, 'ko'),
);
const years = [...new Set(listed.map((w) => w.date.slice(0, 4)))]
  .sort()
  .reverse();
const courses = [
  ...new Map(
    listed.filter((w) => w.course).map((w) => [w.course!.id, w.course!]),
  ).values(),
];
---

<Base title="전체 자료" active="archive">
  <section class="page-intro archive-intro page-gutter" data-slide-exempt>
    <span class="eyebrow">THE ARCHIVE</span>
    <h1>전체 자료</h1>
    <p class="intro-text">
      발표 본문과 영상 자막에서 필요한 내용을 찾아보세요.
    </p>
    <div class="subnav">
      {courses.length > 0 && <a href="/courses/">과목별 강의</a>}
      <a href="/videos/">영상 모아보기</a>
    </div>
  </section>
  <div class="page-gutter" data-archive>
    <form class="archive-tools" role="search">
      <label class="search-box">
        <svg
          viewBox="0 0 24 24"
          width="25"
          height="25"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <circle cx="10" cy="10" r="7" />
          <path d="m15 15 6 6" />
        </svg>
        <input
          type="search"
          name="q"
          aria-label="자료 검색"
          placeholder="무엇을 찾고 있나요?"
          autocomplete="off"
        />
        <button type="submit" aria-label="검색">
          ↵
        </button>
      </label>
      <div class="filters">
        <label class="filter-field">
          자료 유형
          <select name="kind">
            <option value="">모든 유형</option>
            {Object.entries(kindLabel).map(([k, v]) => (
              <option value={k}>{v}</option>
            ))}
          </select>
        </label>
        <details class="advanced-filters">
          <summary>상세 필터</summary>
          <div class="advanced-fields">
            <label class="filter-field">
              연도
              <select name="year">
                <option value="">모든 연도</option>
                {years.map((y) => (
                  <option value={y}>{y}</option>
                ))}
              </select>
            </label>
            <label class="filter-field">
              주제
              <select name="topic">
                <option value="">모든 주제</option>
                {topics.map((t) => (
                  <option value={t}>{t}</option>
                ))}
              </select>
            </label>
            {courses.length > 0 && (
              <label class="filter-field">
                과목
                <select name="course">
                  <option value="">모든 과목</option>
                  {courses.map((c) => (
                    <option value={c.id}>{c.title}</option>
                  ))}
                </select>
              </label>
            )}
            <label class="filter-field">
              정렬
              <select name="sort">
                <option value="">자동 · 검색 시 관련도순</option>
                <option value="latest">최신순</option>
                <option value="oldest">오래된순</option>
                <option value="title">제목순</option>
                <option value="relevance">관련도순</option>
              </select>
            </label>
          </div>
        </details>
        <button type="reset" class="clear-filters">
          조건 초기화
        </button>
      </div>
    </form>
    <div class="results-toolbar">
      <p class="result-count" role="status" aria-live="polite">
        전체 {listed.length}개 자료
      </p>
      <div class="view-switch" role="group" aria-label="보기 방식">
        <button type="button" data-view-button="grid" aria-pressed="true">
          카드
        </button>
        <button type="button" data-view-button="list" aria-pressed="false">
          목록
        </button>
      </div>
    </div>
    <noscript>
      <p class="no-js-note">
        현재 모든 자료를 보여드립니다. 검색과 필터를 사용하려면 JavaScript를 켜
        주세요.
      </p>
    </noscript>
    <div class="empty-state" hidden>
      <h2>아직 만나는 자료가 없네요.</h2>
      <p>검색어를 줄이거나 다른 주제를 선택해 보세요.</p>
      <button class="text-link" data-reset>
        전체 자료 보기 ↗
      </button>
    </div>
    <div class="archive-grid" data-view="grid">
      {listed.map((w, i) => (
        <WorkCard work={w} index={i} />
      ))}
    </div>
  </div>
  <script>
    import '../scripts/archive';
  </script>
</Base>
