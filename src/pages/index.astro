---
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import { featured, listed } from '../lib/content';
const recent = [...listed]
  .sort((a, b) =>
    (b.registeredAt || b.date).localeCompare(a.registeredAt || a.date),
  )
  .filter((w) => !w.featuredOrder)
  .slice(0, 4);
---

<Base active="home">
  <section class="studio-opening page-gutter" data-slide-exempt>
    <div class="studio-intro">
      <p class="eyebrow">ACHMAGE · 안창현의 교육 · 발표 · 모션</p>
      <h1>
        교육을 설계하고,
        <br />
        발표와 모션으로
        <br class="desktop-break" /> 전합니다.
      </h1>
      <p class="studio-description">
        안창현의 발표자료와 모션 작업을 모았습니다. 발표는 웹에서 읽거나
        슬라이드로 보고, 모션은 감상하며 필요한 구간을 찾아볼 수 있습니다.
      </p>
      <form class="home-search" action="/archive/" role="search">
        <label class="sr-only" for="home-q">
          자료 검색
        </label>
        <input
          id="home-q"
          name="q"
          type="search"
          placeholder="제목·본문·자막으로 찾기"
        />
        <button type="submit" aria-label="자료 검색">
          검색 ↗
        </button>
      </form>
      <div class="home-routes">
        <a href="/archive/?kind=talk">발표자료 보기 ↗</a>
        <a href="/motion/">모션 감상하기 ↗</a>
      </div>
      <p class="studio-signature">생각을 장면으로.</p>
    </div>
    <div id="selected" class="home-featured">
      <div class="compact-section-head">
        <h2>먼저 만나볼 작업</h2>
        <a href="/archive/">전체 자료 ↗</a>
      </div>
      <div class="featured-pair">
        {featured.map((w, i) => (
          <WorkCard work={w} index={i} large />
        ))}
      </div>
    </div>
  </section>
  <section class="recent-section page-gutter" data-slide-exempt>
    <div class="compact-section-head">
      <div>
        <span class="eyebrow">RECENT ADDITIONS</span>
        <h2>최근 등록한 작업</h2>
        <p>작은 실험도 다음 작업의 재료가 되도록 남깁니다.</p>
      </div>
      <a href="/archive/">자료 더 보기 ↗</a>
    </div>
    <div class="recent-grid">
      {recent.map((w, i) => (
        <WorkCard work={w} index={i + 2} />
      ))}
    </div>
  </section>
  <section class="about-strip page-gutter" data-slide-exempt>
    <span class="eyebrow">ABOUT ACHMAGE</span>
    <div>
      <h2>가르치며 묻고, 만들며 확인합니다.</h2>
      <p>
        AI 활용 읽기 수업을 설계하고, 움직이는 이미지로 설명하는 방법을
        실험합니다. 작업의 의도와 과정을 함께 남깁니다.
      </p>
    </div>
    <a class="text-link" href="/about/">
      안창현의 작업 방식 ↗
    </a>
  </section>
</Base>
