---
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import { featured, listed, media } from '../lib/content';
const listedMedia = media.filter((m) => listed.some((w) => w.id === m.workId));
const recent = [...listed]
  .sort((a, b) => b.date.localeCompare(a.date))
  .filter((w) => !w.featuredOrder)
  .slice(0, 4);
---

<Base active="home">
  <section class="hero page-gutter" data-slide-exempt>
    <div class="hero-topline">
      <span>ACHMAGE / INDEPENDENT STUDIO</span>
      <span class="status-line">
        <i></i> 계속 만드는 중
      </span>
    </div>
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">교육 · 발표 · 모션</p>
        <h1>
          생각을
          <br />
          <span>장면으로.</span>
        </h1>
        <p class="hero-description">
          배움을 설계하고, 이야기를 발표하고,
          <br class="desktop-br" /> 움직이는 이미지로 생각을 확장합니다.
        </p>
        <a class="text-link" href="#selected">
          선별한 작업 보기 <span aria-hidden="true">↘</span>
        </a>
      </div>
      <figure class="hero-figure">
        <img
          src="/images/studio-frame.webp"
          alt="햇빛을 받는 열린 금속 프레임과 푸른 유리, 접힌 종이의 스튜디오 구성"
          width="1536"
          height="1024"
          fetchpriority="high"
        />
        <figcaption>
          <span>01 / FRAME STUDY</span>
          <span>생각의 틀을 열어두기</span>
        </figcaption>
      </figure>
    </div>
    <div class="hero-baseline">
      <span>안창현의 작업과 실험</span>
      <span>PRESENTATIONS &nbsp; / &nbsp; LEARNING &nbsp; / &nbsp; MOTION</span>
      <span aria-hidden="true">↓</span>
    </div>
  </section>
  <section id="selected" class="selected-section page-gutter" data-slide-exempt>
    <div class="section-head">
      <div>
        <span class="eyebrow">SELECTED WORKS / 01</span>
        <h2>지금, 보여드릴 작업.</h2>
      </div>
      <a class="text-link" href="/archive/">
        전체 자료 <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="selected-grid">
      {featured.map((w, i) => (
        <WorkCard work={w} index={i} large />
      ))}
    </div>
  </section>
  <section
    id="motion-studies"
    class="motion-band page-gutter"
    data-slide-exempt
  >
    <div class="motion-band-copy">
      <span class="eyebrow">MOTION / 02</span>
      <h2>
        말로 설명하던 것을,
        <br />
        움직임으로.
      </h2>
      <p>
        물의 흐름에서 도시의 리듬까지.
        <br />
        이미지와 소리로 풀어낸 {listedMedia.length}개의 실험을 만나보세요.
      </p>
      <a class="button light" href="/motion/">
        Motion 작품관 <span aria-hidden="true">↗</span>
      </a>
    </div>
    <a class="motion-triptych" href="/motion/" aria-label="모션 작품관 열기">
      <img
        src="/images/city.webp"
        alt="도시의 맥박 장면"
        width="960"
        height="540"
        loading="lazy"
      />
      <img
        src="/images/book.webp"
        alt="책 한 권이 태어나는 시간 장면"
        width="960"
        height="540"
        loading="lazy"
      />
      <img
        src="/images/racing.webp"
        alt="RACING LAB 장면"
        width="960"
        height="540"
        loading="lazy"
      />
      <span class="round-arrow" aria-hidden="true">
        ↗
      </span>
    </a>
  </section>
  <section id="recent" class="recent-section page-gutter" data-slide-exempt>
    <div class="section-head">
      <div>
        <span class="eyebrow">FIELD NOTES / 03</span>
        <h2>쌓여가는 실험.</h2>
      </div>
      <a class="text-link" href="/archive/">
        아카이브 탐색 <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="recent-grid">
      {recent.map((w, i) => (
        <WorkCard work={w} index={i + 2} />
      ))}
    </div>
  </section>
  <section id="about-studio" class="about-strip page-gutter" data-slide-exempt>
    <span class="eyebrow">ABOUT ACHMAGE</span>
    <p>
      가르치는 사람의 질문과
      <br />
      만드는 사람의 실행 사이에서.
    </p>
    <a class="text-link" href="/about/">
      스튜디오 소개 <span aria-hidden="true">↗</span>
    </a>
  </section>
</Base>
