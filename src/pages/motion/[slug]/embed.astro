---
import FilmPlayer from '../../../components/FilmPlayer.astro';
import { works, media } from '../../../lib/content';
import '../../../styles/global.css';
export function getStaticPaths() {
  return works
    .filter((w) => w.kind === 'motion')
    .map((work) => ({ params: { slug: work.slug }, props: { work } }));
}
const { work } = Astro.props;
const film = media.find((m) => m.workId === work.id)!;
---

<!doctype html>
<html lang="ko" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="robots" content="noindex,follow" />
    <title>{work.title} — Achmage</title>
    <link rel="canonical" href={new URL(work.href, Astro.site)} />
  </head>
  <body class="embed-page">
    <FilmPlayer film={film} slug={work.slug} embedded />
    <style>
      .embed-page .film-stage {
        padding: 0;
      }
      .embed-page .film-stage video {
        max-height: calc(100vh - 80px);
      }
      .embed-page .film-tools {
        padding: 10px 16px;
        font-size: 12px;
      }
    </style>
  </body>
</html>
