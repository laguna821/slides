---
import { slideHref } from '../../../lib/media-links';
import ProjectResources from '../../../components/ProjectResources.astro';
import Base from '../../../layouts/Base.astro';
import FilmPlayer from '../../../components/FilmPlayer.astro';
import { works, media, usages, formatDate } from '../../../lib/content';
export function getStaticPaths() {
  return works
    .filter((w) => w.kind === 'motion')
    .map((work) => ({ params: { slug: work.slug }, props: { work } }));
}
const { work } = Astro.props;
const film = media.find((m) => m.workId === work.id)!;
const current = film.versions.find((v) => v.id === film.currentVersion)!;
const related = usages
  .filter((u) => u.mediaId === film.id)
  .map((u) => ({ usage: u, work: works.find((w) => w.id === u.workId) }))
  .filter((x) => x.work?.visibility === 'listed');
---

<Base
  title={work.title}
  description={work.summary}
  image={work.poster}
  noindex={work.seo === 'noindex' || work.visibility !== 'listed'}
  active="motion"
>
  <section class="page-intro page-gutter" data-slide-exempt>
    <div class="crumb">
      <a href="/motion/">Motion</a>
      <span>/</span>
      <span>{work.status === 'selected' ? '선별 작품' : '습작'}</span>
    </div>
    <span class="eyebrow">{work.topics.join(' / ')}</span>
    <h1>{work.title}</h1>
    <p class="intro-text">{work.summary}</p>
  </section>
  <FilmPlayer
    film={film}
    slug={work.slug}
    productionNote={work.productionNote}
  />
  <section class="page-gutter" style="padding-bottom:70px" data-slide-exempt>
    {related.length > 0 && (
      <div>
        <h2>이 장면을 사용한 발표</h2>
        {related.map((x) => (
          <p>
            <a class="text-link" href={slideHref(x.work!, x.usage.slideId)}>
              {x.work!.title} · {x.usage.label} · {x.usage.start}–{x.usage.end}
              초 ↗
            </a>
          </p>
        ))}
      </div>
    )}
    <div class="credit-block">
      <h2>작품과 출처</h2>
      <div class="subnav">
        {work.artifacts.map((a) => (
          <a href={a.url} target="_blank" rel="noopener noreferrer">
            {a.label} ↗
          </a>
        ))}
      </div>
      <p>{film.credits}</p>
      {current.creditsUrl && (
        <a href={current.creditsUrl} target="_blank" rel="noopener noreferrer">
          원본 출처·제작 기록 ↗
        </a>
      )}
      <p>
        아카이브 등록 {formatDate(work.registeredAt || work.date)} ·{' '}
        {work.status === 'study' ? '제작 실험과 습작' : '선별한 작업'}
      </p>
    </div>
  </section>
<section class="page-gutter resources-section"><ProjectResources work={work} /></section>
</Base>
