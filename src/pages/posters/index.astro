---
import Base from '../../layouts/Base.astro';
import { resources,listed,formatDate } from '../../lib/content';
const posters=resources.filter(r=>listed.some(w=>w.id===r.workId));
---
<Base title="포스터 모아보기" active="archive">
<section class="page-intro archive-intro page-gutter"><span class="eyebrow">POSTERS</span><h1>포스터 모아보기</h1><p class="intro-text">행사와 프로젝트를 한 장에 담은 자료입니다. 전체 보기와 인쇄용 PDF를 함께 제공합니다.</p><div class="subnav"><a href="/archive/?resource=poster">프로젝트에서 찾기 ↗</a><a href="/archive/">전체 자료</a></div></section>
<section class="page-gutter resources-section"><p>{posters.length}개 포스터</p>
{!posters.length?<div class="empty-state"><h2>등록된 포스터가 아직 없습니다.</h2><p>공개할 포스터가 등록되면 관련 프로젝트와 함께 여기에 모입니다.</p><a href="/archive/">전체 자료 둘러보기 ↗</a></div>:<div class="poster-gallery">{posters.map(r=>{const w=listed.find(w=>w.id===r.workId)!;const v=r.versions.find(v=>v.id===r.currentVersion)!;return <article><a href={v.html}><img class="poster-preview" src={r.preview} alt={r.previewAlt} loading="lazy" /></a><p>{formatDate(w.date)}</p><h2><a href={v.html}>{r.title}</a></h2><p>{r.summary}</p><a href={w.href+'#poster-'+r.id}>{w.title} · 프로젝트 보기 ↗</a></article>})}</div>}
</section></Base>
