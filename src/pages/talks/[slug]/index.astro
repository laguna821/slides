---
import PeleResearchers from "../../../components/PeleResearchers.astro";
import { usageHref } from '../../../lib/media-links';
import PeleOverview from '../../../components/PeleOverview.astro';
import ProjectResources from '../../../components/ProjectResources.astro';
import Base from '../../../layouts/Base.astro';
import {
  works,
  media,
  usages,
  kindLabel,
  formatDate,
} from '../../../lib/content';
export function getStaticPaths() {
  return works
    .filter((w) => w.kind !== 'motion')
    .map((work) => ({ params: { slug: work.slug }, props: { work } }));
}
const { work } = Astro.props;
const related = media.filter(
  (m) =>
    work.mediaIds.includes(m.id) ||
    usages.some((u) => u.workId === work.id && u.mediaId === m.id),
);
const html = work.artifacts.find(
  (a) => a.type === 'html' && a.modes.includes('present'),
);
const pdf = work.artifacts.find((a) => a.type === 'pdf');
const outline=work.segments.filter(s=>s.kind!=='poster');
---

<Base
  title={work.title}
  description={work.summary}
  image={work.poster}
  noindex={work.seo === 'noindex' || work.visibility !== 'listed'}
  active="archive"
>
  {work.id === "pele-atlas" ? <PeleResearchers /> : <>
  <section class="page-intro page-gutter" data-slide-exempt>
    <div class="crumb">
      <a href="/archive/">전체 자료</a>
      <span>/</span>
      <span>{kindLabel[work.kind]}</span>
    </div>
    <span class="eyebrow">{work.topics.join(' / ')}</span>
    <h1>{work.title}</h1>
    <p class="intro-text">{work.summary}</p>
    <p class="detail-context">
      {[work.audience,work.event,formatDate(work.date)].filter(Boolean).join(' · ')}
    </p>
    <div class="actions">
      {html && (
        <a class="button" href={html.url}>
          발표 시작 ↗
        </a>
      )}
      {work.reader && (
        <a class="button secondary" href={work.href + 'read/'}>
          편하게 읽기
        </a>
      )}
      {pdf && (
        <a class="button secondary" href={pdf.url}>
          PDF 보기
        </a>
      )}
    </div>
  </section>
  <section class="content-section page-gutter" data-slide-exempt>
    <div class="detail-layout">
      <div>
        <img
          class="detail-image"
          src={work.poster}
          alt={work.posterAlt}
          width="1440"
          height="810"
        />
        {work.kind === 'demo' && <><div class="prose"><p>{work.body}</p></div>{work.id==='pele-social-science' && <PeleOverview />}{work.id==='pele-atlas' && <div class="prose" style="padding-top:32px"><div class="actions"><a class="button" href="/pele/">전체 도식 검토실 · 39개 도표군·104개 사례 ↗</a><a class="button secondary" href="/talks/pele-atlas/explore/">아틀라스 · 웹·세로형 보기 ↗</a></div></div>}</>}
        {work.kind === 'typeface' && <div class="prose"><h2>서체 소개</h2><div set:html={work.readingHtml}/><p style="font-size:clamp(24px,4vw,48px);line-height:1.4;font-weight:650">한글과 영문, 같은 리듬.<br/>The same rhythm.</p><a class="button" href="https://achmage-sametone.achmage2.chatgpt.site/">서체 체험·다운로드 ↗</a></div>}
        {work.takeaways.length > 0 && (
          <div class="prose">
            <h2>이 자료에서 볼 내용</h2>
            <ul>
              {work.takeaways.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
          </div>
        )}
        {outline.length > 0 && <div class="prose">
          <h2>발표의 흐름</h2>
          {outline.length > 30 ? (
            <details>
              <summary>전체 목차 펼치기</summary>
              <ol>{outline.map((s) => (
                <li><a href={work.href + 'read/#' + encodeURIComponent(s.id)}>{s.title}</a></li>
              ))}</ol>
            </details>
          ) : (
            <ol>{outline.map((s) => (
              <li><a href={work.href + 'read/#' + encodeURIComponent(s.id)}>{s.title}</a></li>
            ))}</ol>
          )}
        </div>}
        {related.length > 0 && (
          <div class="prose">
            <h2 id="videos">발표 속 영상 · {related.length}</h2>
            {related.flatMap((m) => {
              const recorded = usages.filter(
                (u) => u.workId === work.id && u.mediaId === m.id,
              );
              const owner = works.find((w) => w.id === m.workId)!;
              return recorded.length
                ? recorded.map((u) => (
                    <p>
                      <a href={usageHref(u, m, owner)}>
                        {m.title} · {u.label} · {u.start}–{u.end}초 ↗
                      </a>
                      <small>
                        사용 버전 {u.version}
                        {u.slideId ? ' · ' + u.slideId : ''}
                      </small>
                    </p>
                  ))
                : [
                    <p>
                      <a
                        href={
                          m.external
                            ? m.versions.find((v) => v.id === m.currentVersion)!
                                .url
                            : owner.href
                        }
                      >
                        {m.title} ↗
                      </a>
                    </p>,
                  ];
            })}
          </div>
        )}
      </div>
      <aside>
        <dl>
          <dt>날짜</dt>
          <dd>{formatDate(work.date)}</dd>
          <dt>유형</dt>
          <dd>{kindLabel[work.kind]}</dd>
          {work.event && (
            <>
              <dt>발표 자리</dt>
              <dd>{work.event}</dd>
            </>
          )}
          <dt>주제</dt>
          <dd>{work.topics.join(' · ')}</dd>
          {work.course && (
            <>
              <dt>과목</dt>
              <dd>
                <a href={'/courses/' + work.course.id + '/'}>
                  {work.course.title} ↗
                </a>
              </dd>
            </>
          )}
        </dl>
      </aside>
    </div>
  </section>
<section class="page-gutter resources-section"><ProjectResources work={work} /></section>
  </>}
</Base>
