---
import Base from '../../../layouts/Base.astro';
import { works } from '../../../lib/content';
export function getStaticPaths() {
  return works
    .filter((w) => w.kind !== 'motion' && w.readingHtml)
    .map((work) => ({ params: { slug: work.slug }, props: { work } }));
}
const { work } = Astro.props;
---

<Base
  title={work.title + ' · 읽기'}
  description={work.summary}
  noindex={work.seo === 'noindex' || work.visibility !== 'listed'}
  active="archive"
>
  <div class="reading-tools page-gutter">
    <a class="text-link" href={work.href}>
      ← 발표 소개
    </a>
    <button class="text-link" data-print>
      인쇄 · PDF 저장 ↗
    </button>
  </div>
  <article class="reader page-gutter">
    <span class="eyebrow">READING MODE</span>
    <h1 style="font-size:clamp(32px,4vw,62px);letter-spacing:-.05em;line-height:1.3;margin:20px 0 40px">
      {work.title}
    </h1>
    <div class="prose" set:html={work.readingHtml} />
  </article>
  <script>
    document
      .querySelector('[data-print]')
      ?.addEventListener('click', () => window.print());
  </script>
</Base>
