---
import Base from '../../../layouts/Base.astro';
import ThemeToggle from '../../../components/ThemeToggle.astro';
import { works, formatDate } from '../../../lib/content';
import '../../../styles/reader.css';
export function getStaticPaths() {
  return works
    .filter((w) => w.reader)
    .map((work) => ({ params: { slug: work.slug }, props: { work } }));
}
const { work } = Astro.props;
const reader = work.reader!;
const relations = work.relations || [];
const md = work.href + 'read.md',
  txt = work.href + 'read.txt';
const depth = Math.min(...reader.headings.map((h) => h.depth));
const source = work.artifacts.find((a) => a.type === 'html');
const pdf = work.artifacts.find((a) => a.type === 'pdf' && a.role === 'slides');
---

<Base
  title={work.title + ' · 웹 편집본'}
  description={work.summary}
  image={work.poster}
  noindex={work.seo === 'noindex' || work.visibility !== 'listed'}
  active="archive"
>
  <div class="reader-toolbar" role="region" aria-label="읽기 탐색과 화면 설정">
    <a href={work.href}>← 발표 소개</a>
    <div>
      <button
        data-open-panel="reader-toc"
        aria-controls="reader-toc"
        aria-expanded="false"
      >
        목차
      </button>
      <ThemeToggle />
      <button
        data-open-panel="reader-tools"
        aria-controls="reader-tools"
        aria-expanded="false"
        aria-label="읽기 도구"
      >
        ···
      </button>
    </div>
    <progress
      id="reader-progress"
      value="0"
      max="100"
      aria-label="읽기 진행률"
    ></progress>
  </div>
  <div class="reader-layout" data-reader-version={reader.version}>
    <article class="reader-article">
      <header class="reader-heading">
        <p class="eyebrow">
          웹 편집본 <span>· {formatDate(work.date)}</span>
        </p>
        <h1>{work.title}</h1>
        <p class="reader-deck">{work.summary}</p>
        <div class="reader-context">
          {work.event && <span>{work.event}</span>}
          <span>{work.audience}</span>
        </div>
        <div class="reader-source-links">
          {source && <a href={source.url}>발표 열기 ↗</a>}
          {pdf && <a href={pdf.url}>발표 PDF ↗</a>}
          {work.readingPdf && (
            <a
              data-reading-pdf
              href={work.readingPdf.url}
              target="_blank"
              rel="noopener"
            >
              읽기용 PDF ↗
            </a>
          )}
          <a href={md} download={work.slug + '.md'}>
            Markdown 저장 ↓
          </a>
        </div>
        <p class="reader-editor-note">
          발표의 주장·수치·인용과 시각자료를 보존하면서 제목과 흐름을 다듬은 웹 편집본입니다.
          <a href={work.href + 'source.md'}>발표 당시 원문 보관본</a>도 별도로 제공합니다.
        </p>
      </header>
      <div id="reader-body" class="reader-prose" set:html={reader.html} />
      <footer class="reader-end">
        <span>끝까지 읽으셨습니다.</span>
        <a href={work.href}>발표와 관련 자료 보기 ↗</a>
      </footer>
    </article>
    <aside
      id="reader-toc"
      class="reader-panel reader-toc"
      aria-label="본문 목차"
      tabindex="-1"
    >
      <div class="reader-panel-title">
        <strong>이 글의 흐름</strong>
        <div class="reader-panel-controls">
          <ThemeToggle />
          <button data-close-panel aria-label="목차 닫기">
            ×
          </button>
        </div>
      </div>
      <nav aria-label="본문 목차">
        <ol>
          {reader.headings.filter((h) => h.depth <= 3).map((h) => (
            <li style={'--depth:' + Math.max(0, h.depth - depth)}>
              <a href={'#' + h.id}>{h.title}</a>
            </li>
          ))}
        </ol>
      </nav>
    </aside>
    <aside
      id="reader-tools"
      class="reader-panel reader-tools"
      aria-label="읽기 도구"
      tabindex="-1"
    >
      <div class="reader-panel-title">
        <strong>읽고, 이어 쓰기</strong>
        <button data-close-panel aria-label="도구 닫기">
          ×
        </button>
      </div>
      <div class="reader-actions">
        <button data-copy-section>현재 문단 링크 복사</button>
        <button data-copy-reader="text" data-url={txt}>
          본문 복사
        </button>
        <button data-copy-reader="markdown" data-url={md}>
          Markdown 복사
        </button>
        <a href={md} download={work.slug + '.md'}>
          Markdown 저장 ↓
        </a>
        {work.readingPdf && (
          <>
            <a
              data-reader-print
              href={work.readingPdf.url}
              target="_blank"
              rel="noopener"
            >
              읽기용 PDF ↗
            </a>
            <a
              data-download-pdf
              href={work.readingPdf.url}
              download={work.slug + '-reading.pdf'}
            >
              PDF 저장 ↓
            </a>
            <small>A4 · 2단 편집 · {work.readingPdf.pages}쪽</small>
          </>
        )}
      </div>
      <details class="reader-connections" open>
        <summary>
          연결 지도 <span>{relations.length}</span>
        </summary>
        <p class="graph-legend">
          <span>— 실제 인용·연결</span>
          <span>┄ 같은 주제</span>
        </p>
        {relations.length > 0 ? (
          <>
            <svg
              class="reader-graph"
              viewBox="0 0 240 210"
              role="img"
              aria-label="현재 자료 중심 연결 지도. 아래 목록에서 관계와 자료 제목을 확인할 수 있습니다."
            >
              {relations.map((r, i) => {
                const a = (i * 2 * Math.PI) / relations.length - Math.PI / 2,
                  x = 120 + 85 * Math.cos(a),
                  y = 105 + 75 * Math.sin(a);
                return (
                  <>
                    <line
                      x1="120"
                      y1="105"
                      x2={x}
                      y2={y}
                      class:list={[
                        'graph-edge',
                        { 'topic-edge': !r.kinds.includes('citation') },
                      ]}
                    />
                    <a href={r.href} aria-label={r.title}>
                      <title>{r.title}</title>
                      <circle cx={x} cy={y} r="16" />
                      <text x={x} y={y + 4} text-anchor="middle">
                        {i + 1}
                      </text>
                    </a>
                  </>
                );
              })}
              <circle cx="120" cy="105" r="23" class="graph-center" />
              <text x="120" y="109" text-anchor="middle">
                이 글
              </text>
            </svg>
            <ol class="relation-list">
              {relations.map((r) => (
                <li>
                  <a href={r.href}>{r.title}</a>
                  <small>
                    {r.kinds.includes('citation') ? '실제 인용·연결' : ''}
                    {r.kinds.length === 2 ? ' · ' : ''}
                    {r.topics.length ? '같은 주제: ' + r.topics.join(', ') : ''}
                  </small>
                </li>
              ))}
            </ol>
          </>
        ) : (
          <p class="reader-empty">아직 연결된 공개 자료가 없습니다.</p>
        )}
      </details>
    </aside>
  </div>
  <div class="reader-backdrop" hidden></div>
  <p class="reader-status" role="status" aria-live="polite"></p>
  <dialog id="reader-image">
    <button data-close-image aria-label="이미지 닫기">
      닫기 ×
    </button>
    <img alt="" />
    <p></p>
    <a target="_blank" rel="noopener noreferrer">
      원본 이미지 열기 ↗
    </a>
  </dialog>
  <dialog id="reader-copy-fallback">
    <h2>직접 복사하기</h2>
    <p>
      복사 권한이 제한되어 있습니다. 아래 내용을 선택해 복사하거나 Markdown
      파일로 저장할 수 있습니다.
    </p>
    <textarea aria-label="복사할 본문" readonly></textarea>
    <button data-close-copy>닫기</button>
    <a href={md} download={work.slug + '.md'}>
      Markdown 저장 ↓
    </a>
  </dialog>
  <script>
    import '../../../scripts/reader';
  </script>
</Base>
