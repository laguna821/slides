---
import Base from '../../../../layouts/Base.astro';
import cases from '../../../../../content/pele-examples.json';
const groups = [
  ...new Map(
    cases.map((c) => [c.familyId, { id: c.familyId, name: c.family }]),
  ).values(),
];
---

<Base
  title="장표별 제작 코드"
  description="9개 분석군·18장 발표 데모. Pele 관계도와 정밀 SVG 통계 그래프를 결합하고, 장표마다 실제 제작 코드를 나란히 공개합니다."
  image="/images/pele-social-science.png"
  active="archive"
>
  <section class="page-intro page-gutter" data-slide-exempt>
    <div class="crumb">
      <a href="/talks/pele-social-science/">상세 소개</a>
      <span>/</span>
      <span>Pele · SOURCE ATLAS</span>
    </div>
    <span class="eyebrow">9개 분석군 · 18개 조건</span>
    <h1>
      결과에서 코드까지,
      <br />한 장씩.
    </h1>
    <p class="intro-text">
      각 예제에서 장표, 대응하는 Pele 관계도, 실제 SVG 제작 분기를 비교합니다.
      코드를 복사해도 통계 계산은 별도로 필요합니다.
    </p>
    <div class="actions">
      <a
        class="button"
        href="/decks/pele-social-science/v1.0.0/index.html?mode=stage&viewMode=fit#1"
      >
        원본 18장 보기 ↗
      </a>
      <a class="button secondary" href="https://pele.run/">
        Pele 공식 소개·문법 ↗
      </a>
    </div>
  </section>
  <nav class="page-gutter atlas-nav" aria-label="분석군별 코드">
    {groups.map((g) => (
      <a href={'#' + g.id}>{g.name}</a>
    ))}
  </nav>
  <section class="page-gutter atlas-body">
    {groups.map((g) => (
      <section class="analysis-family" id={g.id}>
        <div class="family-header">
          <span class="eyebrow">{g.id.toUpperCase()}</span>
          <h2>{g.name}</h2>
        </div>
        <div class="case-pair">
          {cases
            .filter((c) => c.familyId === g.id)
            .map((c) => (
              <a
                class="case-link"
                href={'/talks/pele-social-science/code/' + c.id + '/'}
              >
                <div class="case-preview">
                  <img
                    src={c.sourceBase + '/slide.png'}
                    alt={c.title}
                    width="1920"
                    height="1080"
                    loading="lazy"
                  />
                </div>
                <div class="case-caption">
                  <span class="case-no">
                    {String(c.number).padStart(2, '0')}
                  </span>
                  <div>
                    <p class="condition">{c.condition}</p>
                    <h3>{c.title}</h3>
                    <p class="sample">{c.sample}</p>
                  </div>
                  <span aria-hidden="true">↗</span>
                </div>
              </a>
            ))}
        </div>
      </section>
    ))}
  </section>
  <section class="page-gutter scope-panel">
    <div class="prose">
      <h2>사용 데이터와 검증 범위</h2>
      <p>
        ANES96의 944명 비가중 탐색 분석과 Political Democracy의 75개 국가 모형을
        사용했습니다. 예상 투표는 실제 투표가 아니며, TV 뉴스 이용 단위는 주당
        횟수입니다.
      </p>
      <p>
        스킬 0.7 검토본에 분석군별 설계·재현 소스·평가를 반영했습니다. 이전
        실험의 독립 수치 검사 33건과 브라우저 검증은 공개 웹사이트의 새 검수를
        대신하지 않습니다. 실제 청중 이해도와 물리 모바일 기기 검증은
        별도입니다.
      </p>
    </div>
  </section>
</Base>
<style>
  .atlas-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding-bottom: 48px;
  }
  .atlas-nav a {
    padding: 10px 14px;
    min-height: 44px;
    border: 1px solid var(--line);
    border-radius: 6px;
    font-size: 15px;
  }
  .atlas-nav a:hover {
    border-color: var(--accent-text);
    color: var(--accent-text);
  }
  .analysis-family {
    padding: 40px 0 64px;
    border-top: 1px solid var(--line);
    scroll-margin-top: 110px;
  }
  .family-header {
    display: flex;
    gap: 24px;
    align-items: baseline;
    margin-bottom: 24px;
  }
  .family-header h2 {
    margin: 0;
    font-size: clamp(26px, 3vw, 42px);
  }
  .case-pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
  }
  .case-link {
    display: block;
    min-width: 0;
  }
  .case-preview {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: #fff;
    aspect-ratio: 16/9;
  }
  .case-preview img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .case-caption {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 20px;
    padding-top: 20px;
  }
  .case-no {
    color: var(--accent-text);
    font-size: 24px;
    font-variant-numeric: tabular-nums;
  }
  .condition {
    margin: 0 0 8px;
    color: var(--muted);
    font-size: 14px;
  }
  .case-caption h3 {
    margin: 0;
    font-size: 23px;
    line-height: 1.4;
    font-weight: 650;
  }
  .sample {
    margin: 12px 0 0;
    color: var(--muted);
    font-size: 13px;
  }
  .case-link:hover h3 {
    color: var(--blue);
  }
  .scope-panel {
    padding-top: 48px;
    padding-bottom: 80px;
    background: var(--soft);
  }
  @media (max-width: 700px) {
    .case-pair {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .family-header {
      display: block;
    }
    .case-caption {
      gap: 12px;
    }
    .case-caption h3 {
      font-size: 21px;
    }
    .atlas-nav {
      padding-bottom: 24px;
    }
  }
</style>
