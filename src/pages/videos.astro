---
import Base from '../layouts/Base.astro';
import { media, listed, formatDuration } from '../lib/content';
const videos = media.filter((m) => listed.some((w) => w.id === m.workId));
---

<Base title="영상 모아보기" active="archive">
  <section class="page-intro page-gutter" data-slide-exempt>
    <span class="eyebrow">VIDEO LIBRARY</span>
    <h1>이야기를 여는 장면들.</h1>
    <p class="intro-text">
      등록된 모션 작품을 한곳에서 찾아봅니다.
      <br />
      작품을 열어 필요한 구간을 선택하고 다음 발표에 연결하세요.
    </p>
    <div class="subnav">
      <a href="/motion/">Motion 작품관</a>
      <a href="/archive/">전체 자료</a>
    </div>
  </section>
  <section class="content-section page-gutter" data-slide-exempt>
    <p class="result-count" style="margin-bottom:25px">
      {videos.length}개 영상
    </p>
    <div class="video-grid">
      {videos.map((m) => {
        const w = listed.find((w) => w.id === m.workId)!;
        const v = m.versions.find((v) => v.id === m.currentVersion)!;
        const href = m.external ? v.url : w.href;
        return (
          <article class="video-tile">
            <a href={href}>
              <img
                src={m.poster}
                alt={m.title + ' 영상 장면'}
                width="1440"
                height="810"
                loading="lazy"
              />
              <h2>{m.title}</h2>
            </a>
            <p>
              {formatDuration(v.duration)} ·{' '}
              {m.external ? '참고영상' : 'Achmage 모션'}
            </p>
            <a class="text-link" href={href}>
              {m.external ? '참고영상 원본 보기 ↗' : '감상 · 구간 선택 ↗'}
            </a>
          </article>
        );
      })}
    </div>
  </section>
</Base>
